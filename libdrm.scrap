# This is the header of a scrapfile
name="libdrm"
desc="Direct Rendering Manager userspace library."
info="https://gitlab.freedesktop.org/mesa/drm"
version="2.4.124"
license="MIT"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, meson, ninja, linux-headers"
build-type="tarball"
download="https://dri.freedesktop.org/libdrm/libdrm-2.4.124.tar.xz"
build() {
    mkdir -p build && cd build
    meson setup .. --prefix=/usr \
                   --buildtype=release \
                   -Dudev=false \
                   -Dtests=false
    ninja
}
instructions() {
    cd build
    DESTDIR="$SCRAP_PKG_DEST" ninja install
}
