# This is the header of a scrapfile
name="gstreamer"
desc="Open source multimedia framework."
info="https://gstreamer.freedesktop.org/"
version="1.24.11"
license="LGPLv2"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, meson, ninja, glib2"
build-type="tarball"
download="https://gstreamer.freedesktop.org/src/gstreamer/gstreamer-1.24.11.tar.xz"
build() {
    mkdir -p build && cd build
    meson setup .. --prefix=/usr \
                   --buildtype=release \
                   -Dintrospection=disabled \
                   -Dtests=disabled \
                   -Dexamples=disabled \
                   -Ddoc=disabled
    ninja
}
instructions() {
    cd build
    DESTDIR="$SCRAP_PKG_DEST" ninja install
}
