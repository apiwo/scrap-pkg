# This is the header of a scrapfile
name="ca-certificates"
desc="Common CA root certificates for SSL/TLS verification."
info="https://curl.se/docs/caextract.html"
version="2025-01-28"
license="MPL-2.0"
maintainer="apiwo"
arch="x86_64"
priority="required"
depends="openssl"
build-type="tarball"
download="https://curl.se/ca/cacert-2025-01-28.pem"
build() {
    # Nothing to compile
    true
}
instructions() {
    mkdir -p "$SCRAP_PKG_DEST/etc/ssl/certs"
    cp cacert-2025-01-28.pem "$SCRAP_PKG_DEST/etc/ssl/certs/ca-bundle.crt"
    ln -sf ca-bundle.crt "$SCRAP_PKG_DEST/etc/ssl/certs/ca-certificates.crt"
    mkdir -p "$SCRAP_PKG_DEST/usr/share/ca-certificates"
    cp cacert-2025-01-28.pem "$SCRAP_PKG_DEST/usr/share/ca-certificates/ca-bundle.crt"
}
