# This is the header of a scrapfile
name="fzf"
desc="A command-line fuzzy finder."
info="https://github.com/junegunn/fzf"
version="0.57.0"
license="MIT"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make"
build-type="tarball"
download="https://github.com/junegunn/fzf/archive/refs/tags/v0.57.0.tar.gz"
build() {
    make
}
instructions() {
    install -Dm755 target/fzf "$SCRAP_PKG_DEST/usr/bin/fzf" 2>/dev/null || \
    install -Dm755 fzf        "$SCRAP_PKG_DEST/usr/bin/fzf"
    mkdir -p "$SCRAP_PKG_DEST/usr/share/fzf"
    cp shell/completion.bash shell/key-bindings.bash \
       shell/completion.zsh  shell/key-bindings.zsh \
       "$SCRAP_PKG_DEST/usr/share/fzf/" 2>/dev/null || true
}
