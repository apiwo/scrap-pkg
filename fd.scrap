# This is the header of a scrapfile
name="fd"
desc="A simple, fast and user-friendly alternative to find."
info="https://github.com/sharkdp/fd"
version="10.2.0"
license="MIT"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make"
build-type="tarball"
download="https://github.com/sharkdp/fd/archive/refs/tags/v10.2.0.tar.gz"
build() {
    cargo build --release --locked
}
instructions() {
    install -Dm755 target/release/fd "$SCRAP_PKG_DEST/usr/bin/fd"
}
