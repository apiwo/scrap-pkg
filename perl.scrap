# This is the header of a scrap
filename="perl"
desc="The Perl programming language interpreter."
info="https://www.perl.org/"
version="5.40.0"
license="GPL/Artistic"
maintainer="apiwo"
arch="x86_64"
priority="required"
depends="gcc, make, libc-dev, zlib-dev, libbzip2-dev"
build-type="tarball"
download="https://www.cpan.org/src/5.0/perl-5.40.0.tar.gz"
build() {
    sh Configure -des \
        -Dprefix=/usr \
        -Dvendorprefix=/usr \
        -Dprivlib=/usr/lib/perl5/5.40/core_perl \
        -Darchlib=/usr/lib/perl5/5.40/core_perl \
        -Dsitelib=/usr/lib/perl5/5.40/site_perl \
        -Dsitearch=/usr/lib/perl5/5.40/site_perl \
        -Dvendorlib=/usr/lib/perl5/5.40/vendor_perl \
        -Dvendorarch=/usr/lib/perl5/5.40/vendor_perl \
        -Dman1dir=/usr/share/man/man1 \
        -Dman3dir=/usr/share/man/man3 \
        -Dpager="/usr/bin/less -isR" \
        -Duseshrplib \
        -Dusethreads
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
