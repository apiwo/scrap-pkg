# This is the header of a scrapfile
name="libgdbm"
desc="GNU database manager library."
info="https://www.gnu.org/software/gdbm/"
version="1.24"
license="GPLv3"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, readline"
build-type="tarball"
download="https://ftp.gnu.org/gnu/gdbm/gdbm-1.24.tar.gz"
build() {
    ./configure --prefix=/usr \
                --disable-static \
                --enable-libgdbm-compat
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
