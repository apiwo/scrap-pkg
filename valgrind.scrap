# This is the header of a scrapfile
name="valgrind"
desc="Instrumentation framework for dynamic analysis tools."
info="https://valgrind.org/"
version="3.24.0"
license="GPLv2"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, linux-headers"
build-type="tarball"
download="https://sourceware.org/pub/valgrind/valgrind-3.24.0.tar.bz2"
build() {
    ./configure --prefix=/usr
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
