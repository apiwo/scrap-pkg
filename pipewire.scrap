# This is the header of a scrapfile
name="pipewire"
desc="Low-latency audio/video router and processor."
info="https://pipewire.org/"
version="1.2.7"
license="MIT"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, meson, ninja, alsa-lib, dbus, glib2, libcap-dev"
build-type="tarball"
download="https://gitlab.freedesktop.org/pipewire/pipewire/-/archive/1.2.7/pipewire-1.2.7.tar.gz"
build() {
    mkdir -p build && cd build
    meson setup .. --prefix=/usr \
                   --buildtype=release \
                   -Dsession-managers=[] \
                   -Ddocs=disabled \
                   -Dtests=disabled
    ninja
}
instructions() {
    cd build
    DESTDIR="$SCRAP_PKG_DEST" ninja install
}
