# This is the header of a scrapfile
name="cargo"
desc="The Rust package manager (installed via rustup)."
info="https://doc.rust-lang.org/cargo/"
version="stable"
license="MIT"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, curl"
build-type="git"
CLIMB=NO
download="https://sh.rustup.rs"
build() {
    # rustup handles everything
    true
}
instructions() {
    # Download and run rustup installer non-interactively
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --no-modify-path --default-toolchain stable
    mkdir -p "$SCRAP_PKG_DEST/usr/bin"
    # Symlink cargo and rustc into system path
    ln -sf "$HOME/.cargo/bin/cargo" "$SCRAP_PKG_DEST/usr/bin/cargo"
    ln -sf "$HOME/.cargo/bin/rustc" "$SCRAP_PKG_DEST/usr/bin/rustc"
    ln -sf "$HOME/.cargo/bin/rustup" "$SCRAP_PKG_DEST/usr/bin/rustup"
}
