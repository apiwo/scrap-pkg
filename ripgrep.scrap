# This is the header of a scrapfile
name="ripgrep"
desc="Recursively search directories with a regex pattern (rg)."
info="https://github.com/BurntSushi/ripgrep"
version="14.1.1"
license="MIT"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make"
build-type="tarball"
download="https://github.com/BurntSushi/ripgrep/archive/refs/tags/14.1.1.tar.gz"
build() {
    cargo build --release --locked
}
instructions() {
    mkdir -p "$SCRAP_PKG_DEST/usr/bin"
    install -Dm755 target/release/rg "$SCRAP_PKG_DEST/usr/bin/rg"
    mkdir -p "$SCRAP_PKG_DEST/usr/share/man/man1"
    cp doc/rg.1 "$SCRAP_PKG_DEST/usr/share/man/man1/"
}
