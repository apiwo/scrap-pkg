# This is the header of a scrap
filename="e2fsprogs"
desc="Ext2/3/4 filesystem utilities."
info="https://e2fsprogs.sourceforge.net/"
version="1.47.2"
license="GPLv2"
maintainer="apiwo"
arch="x86_64"
priority="required"
depends="gcc, make, util-linux"
build-type="tarball"
download="https://downloads.sourceforge.net/project/e2fsprogs/e2fsprogs/v1.47.2/e2fsprogs-1.47.2.tar.gz"
build() {
    mkdir -p build && cd build
    ../configure --prefix=/usr \
                 --sysconfdir=/etc \
                 --enable-elf-shlibs \
                 --disable-libblkid \
                 --disable-libuuid \
                 --disable-uuidd \
                 --disable-fsck
    make
}
instructions() {
    cd build
    make DESTDIR="$SCRAP_PKG_DEST" install
    make DESTDIR="$SCRAP_PKG_DEST" install-libs
    chmod -v u+w "$SCRAP_PKG_DEST/usr/lib/"{libcom_err,libe2p,libext2fs,libss}.a
}
