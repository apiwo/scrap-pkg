# This is the header of a scrapfile
name="alsa-lib"
desc="Advanced Linux Sound Architecture library."
info="https://www.alsa-project.org/"
version="1.2.13"
license="LGPLv2.1"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, linux-headers"
build-type="tarball"
download="https://www.alsa-project.org/files/pub/lib/alsa-lib-1.2.13.tar.bz2"
build() {
    ./configure --prefix=/usr \
                --disable-static
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
