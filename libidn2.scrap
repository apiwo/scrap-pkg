# This is the header of a scrapfile
name="libidn2"
desc="GNU Internationalized Domain Name library."
info="https://www.gnu.org/software/libidn/#libidn2"
version="2.3.7"
license="LGPLv3"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, libunistring"
build-type="tarball"
download="https://ftp.gnu.org/gnu/libidn/libidn2-2.3.7.tar.gz"
build() {
    ./configure --prefix=/usr --disable-static
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
