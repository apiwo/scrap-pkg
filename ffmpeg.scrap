# This is the header of a scrapfile
name="ffmpeg"
desc="Complete, cross-platform multimedia framework."
info="https://ffmpeg.org/"
version="7.1"
license="GPLv2"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, nasm, zlib-dev, bzip2, xz, libssl-dev, alsa-lib, libpulse-dev, libx264-dev, libx265-dev, libvpx-dev, libfdk-aac-dev, libmp3lame-dev, libvorbis-dev, libfreetype2-dev, fontconfig"
build-type="tarball"
download="https://ffmpeg.org/releases/ffmpeg-7.1.tar.xz"
build() {
    ./configure --prefix=/usr \
                --enable-shared \
                --disable-static \
                --enable-gpl \
                --enable-nonfree \
                --enable-openssl \
                --enable-libx264 \
                --enable-libx265 \
                --enable-libvpx \
                --enable-libfdk-aac \
                --enable-libmp3lame \
                --enable-libvorbis \
                --enable-libfreetype \
                --enable-libfontconfig \
                --enable-alsa \
                --enable-libpulse
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
