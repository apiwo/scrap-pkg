# This is the header of a scrapfile
name="OpenSSL"
desc="Toolkit for TLS/SSL and general-purpose cryptography."
info="https://www.openssl.org/"
version="3.4.1"
license="Apache-2.0"
maintainer="apiwo"
# Extra properties for the scrap manager
arch="x86_64"
priority="required"
depends="gcc, make, libc-dev, zlib-dev"
build-type="tarball"
# Remote source location
download="https://www.openssl.org/source/openssl-3.4.1.tar.gz"
build() {
    ./Configure --prefix=/usr \
                --openssldir=/etc/ssl \
                --libdir=lib \
                shared \
                zlib-dynamic
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
