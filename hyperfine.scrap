# This is the header of a scrapfile
name="hyperfine"
desc="A command-line benchmarking tool."
info="https://github.com/sharkdp/hyperfine"
version="1.19.0"
license="MIT"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make"
build-type="tarball"
download="https://github.com/sharkdp/hyperfine/archive/refs/tags/v1.19.0.tar.gz"
build() {
    cargo build --release --locked
}
instructions() {
    install -Dm755 target/release/hyperfine "$SCRAP_PKG_DEST/usr/bin/hyperfine"
}
