# This is the header of a scrapfile
name="lvm2"
desc="Logical Volume Manager 2 utilities."
info="https://sourceware.org/lvm2/"
version="2.03.28"
license="GPLv2"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, libaio-dev"
build-type="tarball"
download="https://sourceware.org/pub/lvm2/LVM2.2.03.28.tgz"
build() {
    ./configure --prefix=/usr \
                --exec-prefix= \
                --enable-cmdlib \
                --enable-pkgconfig \
                --enable-udev_sync
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
