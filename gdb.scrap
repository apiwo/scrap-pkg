# This is the header of a scrapfile
name="gdb"
desc="GNU Debugger."
info="https://www.gnu.org/software/gdb/"
version="15.2"
license="GPLv3"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, python3, libncurses-dev, libexpat-dev, xz"
build-type="tarball"
download="https://ftp.gnu.org/gnu/gdb/gdb-15.2.tar.xz"
build() {
    mkdir -p build && cd build
    ../configure --prefix=/usr \
                 --with-system-readline \
                 --with-python=/usr/bin/python3
    make
}
instructions() {
    cd build
    make DESTDIR="$SCRAP_PKG_DEST" install
}
