# This is the header of a scrapfile
name="mesa"
desc="Open source OpenGL/Vulkan implementation."
info="https://www.mesa3d.org/"
version="24.3.4"
license="MIT"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, meson, ninja, libdrm-dev, python3, libxcb-dev, libx11-dev, libxext-dev"
build-type="tarball"
download="https://mesa.freedesktop.org/archive/mesa-24.3.4.tar.xz"
build() {
    mkdir -p build && cd build
    meson setup .. --prefix=/usr \
                   --buildtype=release \
                   -Dgallium-drivers=auto \
                   -Dvulkan-drivers=auto \
                   -Dglx=dri \
                   -Degl=enabled \
                   -Dgbm=enabled \
                   -Dshared-glapi=enabled \
                   -Dopengl=true
    ninja
}
instructions() {
    cd build
    DESTDIR="$SCRAP_PKG_DEST" ninja install
}
