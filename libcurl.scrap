# This is the header of a scrapfile
name="libcurl"
desc="Multi-protocol file transfer library."
info="https://curl.se/"
version="8.11.1"
license="curl"
maintainer="apiwo"
arch="x86_64"
priority="required"
depends="gcc, make, openssl, zlib-dev"
build-type="tarball"
download="https://curl.se/download/curl-8.11.1.tar.xz"
build() {
    ./configure --prefix=/usr \
                --disable-static \
                --with-openssl \
                --enable-threaded-resolver \
                --with-ca-path=/etc/ssl/certs
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
