# This is the header of a scrapfile
name="yq"
desc="Portable command-line YAML/JSON/XML processor."
info="https://github.com/mikefarah/yq"
version="4.45.1"
license="MIT"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make"
build-type="tarball"
download="https://github.com/mikefarah/yq/archive/refs/tags/v4.45.1.tar.gz"
build() {
    go build -o yq .
}
instructions() {
    install -Dm755 yq "$SCRAP_PKG_DEST/usr/bin/yq"
}
