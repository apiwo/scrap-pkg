# This is the header of a scrap
filename="dhcpcd"
desc="DHCP and DHCPv6 client."
info="https://github.com/NetworkConfiguration/dhcpcd"
version="10.0.10"
license="BSD-2-Clause"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, libc-dev"
build-type="tarball"
download="https://github.com/NetworkConfiguration/dhcpcd/releases/download/v10.0.10/dhcpcd-10.0.10.tar.xz"
build() {
    ./configure --prefix=/usr \
                --sysconfdir=/etc \
                --libexecdir=/usr/lib/dhcpcd \
                --dbdir=/var/lib/dhcpcd \
                --runstatedir=/run
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
