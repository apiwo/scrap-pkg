# This is the header of a scrapfile
name="libusb"
desc="Userspace USB programming library."
info="https://libusb.info/"
version="1.0.27"
license="LGPLv2.1"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, linux-headers"
build-type="tarball"
download="https://github.com/libusb/libusb/releases/download/v1.0.27/libusb-1.0.27.tar.bz2"
build() {
    ./configure --prefix=/usr --disable-static
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
