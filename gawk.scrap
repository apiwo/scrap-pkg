# This is the header of a scrapfile
name="gawk"
desc="GNU awk: a pattern scanning and processing language."
info="https://www.gnu.org/software/gawk/"
version="5.3.1"
license="GPLv3"
maintainer="apiwo"
# Extra properties for the scrap manager
arch="x86_64"
priority="required"
depends="gcc, make, libc-dev"
build-type="tarball"
# Remote source location
download="https://ftp.gnu.org/gnu/gawk/gawk-5.3.1.tar.xz"
build() {
    ./configure --prefix=/usr
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
