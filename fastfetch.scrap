# This is the header of a scrapfile
name="fastfetch"
desc="A fast, feature-rich, neofetch-like system information tool."
info="https://github.com/fastfetch-cli/fastfetch"
version="2.62.1"
license="MIT"
maintainer="apiwo"
# Extra properties for the scrap manager
arch="x86_64"
priority="optional"
depends="gcc, make, cmake, libpci-dev, libvulkan-dev, libxrandr-dev, libwayland-dev, zlib-dev"
build-type="git"
# Remote source location
download="https://github.com/fastfetch-cli/fastfetch.git"
build() {
    mkdir -p build && cd build
    cmake .. -DCMAKE_BUILD_TYPE=Release \
             -DCMAKE_INSTALL_PREFIX=/usr
    make
}
instructions() {
    cd build
    make DESTDIR="$SCRAP_PKG_DEST" install
}
