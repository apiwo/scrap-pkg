# This is the header of a scrapfile
name="man-db"
desc="The on-line manual database."
info="https://www.nongnu.org/man-db/"
version="2.13.0"
license="GPLv2"
maintainer="apiwo"
arch="x86_64"
priority="required"
depends="gcc, make, libgdbm-dev, libseccomp-dev, groff"
build-type="tarball"
download="https://download.savannah.gnu.org/releases/man-db/man-db-2.13.0.tar.xz"
build() {
    ./configure --prefix=/usr \
                --docdir=/usr/share/doc/man-db-2.13.0 \
                --sysconfdir=/etc \
                --disable-setuid \
                --enable-cache-owner=bin \
                --with-browser=/usr/bin/lynx \
                --with-vgrind=/usr/bin/vgrind \
                --with-grap=/usr/bin/grap \
                --with-systemdtmpfilesdir=
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
