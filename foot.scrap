# This is the header of a scrapfile
name="foot"
desc="A fast, lightweight Wayland terminal emulator."
info="https://codeberg.org/dnkl/foot"
version="1.21.0"
license="MIT"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, meson, ninja, wayland, libxkbcommon-dev, fontconfig, freetype2, harfbuzz, libpixman-dev"
build-type="tarball"
download="https://codeberg.org/dnkl/foot/releases/download/1.21.0/foot-1.21.0.tar.gz"
build() {
    mkdir -p build && cd build
    meson setup .. --prefix=/usr \
                   --buildtype=release \
                   -Dterminfo=disabled
    ninja
}
instructions() {
    cd build
    DESTDIR="$SCRAP_PKG_DEST" ninja install
}
