# This is the header of a scrapfile
name="gtk4"
desc="GIMP Toolkit - graphical widget library (version 4)."
info="https://www.gtk.org/"
version="4.16.12"
license="LGPLv2.1"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, meson, ninja, glib2, cairo, pango, libpng, graphene-dev, libepoxy-dev, libxkbcommon-dev, wayland, at-spi2-core, shaderc"
build-type="tarball"
download="https://download.gnome.org/sources/gtk/4.16/gtk-4.16.12.tar.xz"
build() {
    mkdir -p build && cd build
    meson setup .. --prefix=/usr \
                   --buildtype=release \
                   -Dintrospection=disabled \
                   -Ddemos=false \
                   -Dbuild-examples=false \
                   -Dbuild-tests=false
    ninja
}
instructions() {
    cd build
    DESTDIR="$SCRAP_PKG_DEST" ninja install
}
