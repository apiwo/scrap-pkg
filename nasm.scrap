# This is the header of a scrapfile
name="nasm"
desc="Netwide Assembler - 80x86 assembler."
info="https://www.nasm.us/"
version="2.16.03"
license="BSD"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make"
build-type="tarball"
download="https://www.nasm.us/pub/nasm/releasebuilds/2.16.03/nasm-2.16.03.tar.xz"
build() {
    ./configure --prefix=/usr
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
