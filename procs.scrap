# This is the header of a scrapfile
name="procs"
desc="A modern replacement for ps written in Rust."
info="https://github.com/dalance/procs"
version="0.14.8"
license="MIT"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make"
build-type="tarball"
download="https://github.com/dalance/procs/archive/refs/tags/v0.14.8.tar.gz"
build() {
    cargo build --release --locked
}
instructions() {
    install -Dm755 target/release/procs "$SCRAP_PKG_DEST/usr/bin/procs"
}
