# This is the header of a scrap
filename="which"
desc="Shows the full path of shell commands."
info="https://carlowood.github.io/which/"
version="2.21"
license="GPLv3"
maintainer="apiwo"
arch="x86_64"
priority="required"
depends="gcc, make"
build-type="tarball"
download="https://ftp.gnu.org/gnu/which/which-2.21.tar.gz"
build() {
    ./configure --prefix=/usr
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
