# This is the header of a scrapfile
name="mpc"
desc="GNU MPC multiple-precision complex arithmetic library."
info="https://www.multiprecision.org/mpc/"
version="1.3.1"
license="LGPLv3"
maintainer="apiwo"
arch="x86_64"
priority="required"
depends="gcc, make, gmp, mpfr"
build-type="tarball"
download="https://ftp.gnu.org/gnu/mpc/mpc-1.3.1.tar.gz"
build() {
    ./configure --prefix=/usr --disable-static --docdir=/usr/share/doc/mpc-1.3.1
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
