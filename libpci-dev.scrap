# This is the header of a scrapfile
name="libpci-dev"
desc="PCI utilities library and headers (libpci / pciutils)."
info="https://mj.ucw.cz/sw/pciutils/"
version="3.15.0"
license="GPLv2"
maintainer="apiwo"
# Extra properties for the scrap manager
arch="x86_64"
priority="optional"
depends="gcc, make, zlib-dev"
build-type="tarball"
# Remote source location
download="https://mj.ucw.cz/download/linux/pci/pciutils-3.15.0.tar.gz"
build() {
    make PREFIX=/usr \
         SHAREDIR=/usr/share/hwdata \
         SHARED=yes
}
instructions() {
    make PREFIX="$SCRAP_PKG_DEST/usr" \
         SHAREDIR="$SCRAP_PKG_DEST/usr/share/hwdata" \
         SHARED=yes \
         install install-lib
    chmod -v 755 "$SCRAP_PKG_DEST/usr/lib/libpci.so"
}
