# This is the header of a scrapfile
name="tokei"
desc="Count your code quickly and accurately."
info="https://github.com/XAMPPRocky/tokei"
version="12.1.2"
license="MIT"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make"
build-type="tarball"
download="https://github.com/XAMPPRocky/tokei/archive/refs/tags/v12.1.2.tar.gz"
build() {
    cargo build --release --locked
}
instructions() {
    install -Dm755 target/release/tokei "$SCRAP_PKG_DEST/usr/bin/tokei"
}
