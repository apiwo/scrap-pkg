# This is the header of a scrapfile
name="bat"
desc="A cat clone with syntax highlighting and Git integration."
info="https://github.com/sharkdp/bat"
version="0.25.0"
license="MIT"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make"
build-type="tarball"
download="https://github.com/sharkdp/bat/archive/refs/tags/v0.25.0.tar.gz"
build() {
    cargo build --release --locked
}
instructions() {
    install -Dm755 target/release/bat "$SCRAP_PKG_DEST/usr/bin/bat"
    mkdir -p "$SCRAP_PKG_DEST/usr/share/man/man1"
    cp target/release/build/bat-*/out/bat.1 "$SCRAP_PKG_DEST/usr/share/man/man1/" 2>/dev/null || true
}
