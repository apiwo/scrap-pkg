# This is the header of a scrapfile
name="gimp"
desc="GNU Image Manipulation Program."
info="https://www.gimp.org/"
version="2.10.38"
license="GPLv3"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, meson, ninja, gtk3, glib2, babl, gegl, pango, cairo, libpng, libjpeg-turbo, freetype2, fontconfig, libwebp-dev, libmypaint-dev, mypaint-brushes"
build-type="tarball"
download="https://download.gimp.org/mirror/pub/gimp/v2.10/gimp-2.10.38.tar.bz2"
build() {
    ./configure --prefix=/usr \
                --sysconfdir=/etc \
                --without-wmf \
                --without-webkit \
                --without-xpm
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
