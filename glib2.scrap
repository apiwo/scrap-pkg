# This is the header of a scrapfile
name="glib2"
desc="Low-level core library for GTK and GNOME applications."
info="https://docs.gtk.org/glib/"
version="2.82.4"
license="LGPLv2.1"
maintainer="apiwo"
arch="x86_64"
priority="required"
depends="gcc, make, meson, ninja, libffi, pcre2, zlib-dev, libmount-dev"
build-type="tarball"
download="https://download.gnome.org/sources/glib/2.82/glib-2.82.4.tar.xz"
build() {
    mkdir -p build && cd build
    meson setup .. --prefix=/usr \
                   --buildtype=release \
                   -Dman-pages=disabled \
                   -Dintrospection=disabled
    ninja
}
instructions() {
    cd build
    DESTDIR="$SCRAP_PKG_DEST" ninja install
}
