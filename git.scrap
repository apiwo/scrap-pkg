# This is the header of a scrap
filename="git"
desc="Distributed version control system."
info="https://git-scm.com/"
version="2.47.1"
license="GPLv2"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, openssl, libcurl, expat, zlib-dev, perl"
build-type="tarball"
download="https://www.kernel.org/pub/software/scm/git/git-2.47.1.tar.xz"
build() {
    make prefix=/usr \
         CFLAGS="$CFLAGS" \
         all
}
instructions() {
    make prefix=/usr DESTDIR="$SCRAP_PKG_DEST" install
}
