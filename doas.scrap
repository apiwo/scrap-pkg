# This is the header of a scrapfile
name="doas"
desc="Simple, minimal sudo alternative from OpenBSD."
info="https://github.com/slicer69/doas"
version="6.8.2"
license="ISC"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, libpam"
build-type="tarball"
download="https://github.com/slicer69/doas/archive/refs/tags/6.8.2.tar.gz"
build() {
    # PAM is the correct auth backend on Linux (not BSD bsd_auth)
    make PREFIX=/usr PAM=1
}
instructions() {
    make PREFIX=/usr DESTDIR="$SCRAP_PKG_DEST" install
    # setuid bit required for privilege escalation
    chmod 4755 "$SCRAP_PKG_DEST/usr/bin/doas"
    # Create default config allowing wheel group with persistence
    mkdir -p "$SCRAP_PKG_DEST/etc"
    cat > "$SCRAP_PKG_DEST/etc/doas.conf" << 'CONF'
# doas configuration
# Allow members of the wheel group to run commands as root
permit persist :wheel
# Allow root to run as anyone without password
permit nopass root
CONF
    # doas.conf must not be world-readable
    chmod 0400 "$SCRAP_PKG_DEST/etc/doas.conf"
    # PAM config for doas
    mkdir -p "$SCRAP_PKG_DEST/etc/pam.d"
    cat > "$SCRAP_PKG_DEST/etc/pam.d/doas" << 'PAM'
auth       include      system-auth
account    include      system-auth
session    include      system-auth
PAM
}
