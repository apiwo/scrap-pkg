# This is the header of a scrapfile
name="gmp"
desc="GNU Multiple Precision arithmetic library."
info="https://gmplib.org/"
version="6.3.0"
license="LGPLv3"
maintainer="apiwo"
arch="x86_64"
priority="required"
depends="gcc, make"
build-type="tarball"
download="https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz"
build() {
    ./configure --prefix=/usr \
                --enable-cxx \
                --disable-static \
                --docdir=/usr/share/doc/gmp-6.3.0
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
