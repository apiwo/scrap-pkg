# This is the header of a scrapfile
name="diffutils"
desc="GNU Diff Utilities: diff, cmp, diff3, and sdiff."
info="https://www.gnu.org/software/diffutils/"
version="3.10"
license="GPLv3"
maintainer="apiwo"
# Extra properties for the scrap manager
arch="x86_64"
priority="required"
depends="gcc, make, libc-dev"
build-type="tarball"
# Remote source location
download="https://ftp.gnu.org/gnu/diffutils/diffutils-3.10.tar.xz"
build() {
    ./configure --prefix=/usr
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
