# This is the header of a scrapfile
name="picom"
desc="A lightweight compositor for X11."
info="https://github.com/yshui/picom"
version="12"
license="MIT"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, meson, ninja, libx11-dev, libxext-dev, libxcb-dev, libxcb-image-dev, libxcb-glx-dev, libdbus-dev, libev-dev, libpixman-dev, libepoxy-dev, libpcre2-dev"
build-type="tarball"
download="https://github.com/yshui/picom/archive/refs/tags/v12.tar.gz"
build() {
    mkdir -p build && cd build
    meson setup .. --prefix=/usr --buildtype=release
    ninja
}
instructions() {
    cd build
    DESTDIR="$SCRAP_PKG_DEST" ninja install
}
