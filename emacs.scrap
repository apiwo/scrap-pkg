# This is the header of a scrapfile
name="emacs"
desc="GNU Emacs - extensible, self-documenting text editor."
info="https://www.gnu.org/software/emacs/"
version="30.1"
license="GPLv3"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, libncurses-dev, libgnutls-dev, libxml2, libjansson-dev"
build-type="tarball"
download="https://ftp.gnu.org/gnu/emacs/emacs-30.1.tar.xz"
build() {
    ./configure --prefix=/usr \
                --without-x \
                --without-sound \
                --with-gnutls \
                --with-json \
                --with-modules
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
