# This is the header of a scrap
filename="libtool"
desc="GNU libtool - shared library management."
info="https://www.gnu.org/software/libtool/"
version="2.4.7"
license="GPLv2"
maintainer="apiwo"
arch="x86_64"
priority="required"
depends="gcc, make, automake"
build-type="tarball"
download="https://ftp.gnu.org/gnu/libtool/libtool-2.4.7.tar.xz"
build() {
    ./configure --prefix=/usr
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
