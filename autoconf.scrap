# This is the header of a scrapfile
name="autoconf"
desc="GNU Autoconf - automatic configure script builder."
info="https://www.gnu.org/software/autoconf/"
version="2.72"
license="GPLv3"
maintainer="apiwo"
arch="x86_64"
priority="required"
depends="m4, perl"
build-type="tarball"
download="https://ftp.gnu.org/gnu/autoconf/autoconf-2.72.tar.xz"
build() {
    ./configure --prefix=/usr
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
