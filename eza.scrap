# This is the header of a scrapfile
name="eza"
desc="A modern, maintained replacement for ls."
info="https://github.com/eza-community/eza"
version="0.20.14"
license="MIT"
maintainer="apiwo"
arch="x86_64"
priority="optional"
depends="gcc, make, libgit2-dev"
build-type="tarball"
download="https://github.com/eza-community/eza/archive/refs/tags/v0.20.14.tar.gz"
build() {
    cargo build --release --locked
}
instructions() {
    install -Dm755 target/release/eza "$SCRAP_PKG_DEST/usr/bin/eza"
}
