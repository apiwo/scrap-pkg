# This is the header of a scrapfile
name="bison"
desc="GNU parser generator."
info="https://www.gnu.org/software/bison/"
version="3.8.2"
license="GPLv3"
maintainer="apiwo"
arch="x86_64"
priority="required"
depends="gcc, make, m4"
build-type="tarball"
download="https://ftp.gnu.org/gnu/bison/bison-3.8.2.tar.xz"
build() {
    ./configure --prefix=/usr --docdir=/usr/share/doc/bison-3.8.2
    make
}
instructions() {
    make DESTDIR="$SCRAP_PKG_DEST" install
}
